shared=(red green blue)
cat /env/shared | tr '\0' ' '
echo
od -c /env/shared | head -1
/bin/rc -c 'echo child sees $shared $#shared'
fromsh=1 /bin/sh -c 'echo sh sees $fromsh'
printenv shared
rfork e
private=yes
/bin/rc -c 'echo in the copy: $private'
cd /tmp
pwd
cd
pwd
