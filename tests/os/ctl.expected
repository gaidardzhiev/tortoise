ctltest: all ok
$ sleep 100 &
[11]
$ echo stop > /proc/$!/ctl
$ ps | grep ' sleep$'
   11     3 stop   sleep
[1]+ Stopped sleep 100
$ echo start > /proc/$!/ctl
$ ps | grep ' sleep$'
   11     3 sleep  sleep
$ echo kill > /proc/$!/ctl; wait
$ rfork n
$ bind '#c' /dev
$ bind -a '#p' /proc
$ ls /dev | head -4
console
tty
null
zero
$ ls '#D'
disk0
disk1
$ cat '#I/ipifc/0/ctl'
lo 127.0.0.1 255.0.0.0 up
$ ns | grep net
bind '#I' /net
bind -a '#l' /net
$ cat /proc/self/args
cat /proc/self/args
$ cat /proc/self/fdtab
0 rw 0 /dev/console
1 rw 0 /dev/console
2 rw 0 /dev/console
3 r 0 /proc/28/fdtab
$ shutdown 0
